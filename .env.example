# Copy to .env.local and fill in real values. Never commit .env.local.

# Min 32 chars, random. Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=

# Staff passwords (usernames are fixed: reception, guard, admin).
# Login is disabled for any role whose password is unset.
STAFF_RECEPTIONIST_PASSWORD=
STAFF_GUARD_PASSWORD=
STAFF_ADMIN_PASSWORD=

# Supabase (production database). Leave unset for in-memory demo mode.
# The service-role key is server-only — NEVER prefix with NEXT_PUBLIC_.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Days to keep visitor selfies before auto-deletion (UU PDP). Default 30.
PHOTO_RETENTION_DAYS=30
